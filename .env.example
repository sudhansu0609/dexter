# Dexter AI Super Assistant - Environment Configuration
# Copy this file to .env and fill in what you need.
# .env is gitignored; this example file is the one that is committed.

# ── Local LLM (the default - Dexter is local-first) ──
# codeBuzz's llama-server (Qwen3.8-27B). Only up while codeBuzz runs; when it
# is, it already holds the GPU, so Dexter uses it first instead of loading a
# second model onto the CPU. Any OpenAI-compatible llama.cpp server works.
LLAMACPP_URL=http://127.0.0.1:8089/v1
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434/v1

# Which local backend Dexter prefers for "auto" requests:
#   auto     - llama-server (8089) if up, then LM Studio, then Ollama (default)
#   llamacpp - force the llama-server first
#   ollama   - run Dexter on Ollama; keeps LM Studio free for other tasks
#              (LM Studio still used as a fallback only if Ollama is down)
#   lmstudio - force LM Studio first
# Point OLLAMA_URL at any Ollama instance (another port/machine) to offload it.
DEXTER_LLM_PROVIDER=lmstudio
# Dexter starts the preferred backend when it is not running (`ollama serve`
# detached, output in data/ollama.log; `lms server start` for LM Studio) - at
# preflight, at startup and whenever a request finds it gone, at most once a
# minute. 0 turns that off.
# DEXTER_AUTOSTART_LLM=1
# DEXTER_AUTOSTART_TIMEOUT=25

# ── Tiered models (instant replies) ──
# A small fast model answers simple conversational turns instantly, and escalates
# to a bigger model for anything needing tools, actions, or current/personal data.
# Both must be pulled on the active provider. Leave DEXTER_FAST_MODEL blank to
# disable the tier and use a single model. When DEXTER_SMART_MODEL is blank the
# escalation uses the provider's default model (OLLAMA_MODEL / auto-detected).
# An explicit model chosen in the UI bypasses tiering and is used as-is.
# The smart tier is a ladder (v12): every escalated turn asks Sentinel for
# DEXTER_SMART_MODEL first and falls back to DEXTER_SMART_MODEL_FALLBACK when
# the card is too full for it, so a busy GPU costs a rung rather than the
# answer. Nothing loads without Sentinel's permission either way. Set the top
# rung to the best model this card can hold when it is free.
# v13: the fast model is allowed to ACT — one tool call with the same candidate
# set the big model would get, before any escalation, so "close notepad" costs a
# second instead of a 7 GB load. It escalates exactly as before on no call, an
# invalid call, a chain sentence, or a tool that failed. DEXTER_FAST_ACT=0
# restores v12 behaviour. Defaults measured on this machine (RTX 5060 Ti):
# qwen3.5:4b got 27 of 30 tool choices right at 111 tok/s in 3.0 GB.
# DEXTER_FAST_MODEL=qwen3.5:4b
# Measured equal on tool choice and better at settling instructions alone (v13):
# DEXTER_FAST_MODEL=gemma4:e4b-it-qat  (needs DEXTER_CPU_RUNG_MAX_MIB=6600 for the CPU rung; its file is 5.9 GB)
# DEXTER_SMART_MODEL=gemma-4-12b
# DEXTER_SMART_MODEL_FALLBACK=qwen2.5:7b
# DEXTER_FAST_ACT=1
# DEXTER_TIERED_LLM=1
# Ollama is spoken to through its own /api/chat, not the OpenAI-compatible shim:
# it is the only endpoint that takes `think`, `keep_alive` and `options` per
# request, and a reasoning model asked through the shim returns empty content.
# DEXTER_OLLAMA_NATIVE=1
# ── Off the GPU (v13, D4) ──
# When Sentinel refuses VRAM but grants RAM, a small rung runs in system memory
# (`options.num_gpu: 0`, about 20 tok/s) instead of not running at all, and the
# fast model is *moved* there rather than dropped when the card is needed. Only
# rungs whose file is at most this many MiB are ever put on the CPU.
# DEXTER_CPU_RUNG_MAX_MIB=5200
# A partial split is tried for the fast model when a full GPU load is refused:
# as many layers on the card as the free VRAM allows. 0 turns that off.
# DEXTER_SPLIT_FAST=1
# How long to wait (seconds) for the memory Dexter just gave back to show up as
# free, when it steps aside so an app the owner asked for can start.
# DEXTER_RELEASE_GRACE_SECS=10

# Leave blank to auto-detect whichever model is loaded in LM Studio.
# For reliable tool calling, load a model with strong function-calling support -
# Qwen2.5-7B-Instruct or Qwen3-8B are the best size/quality trade-off locally.
# A 3B model will misfire on multi-step requests.
# The uncensored Gemma 4 pair, both loaded in LM Studio:
#   DEXTER_FAST_MODEL=gemma-4-e4b-uncensored-hauhaucs-aggressive   (7.5B, warm at boot)
#   DEXTER_SMART_MODEL=gemma4-12b-qat-uncensored-hauhaucs-balanced (12B, on escalation)
LM_STUDIO_MODEL=gemma4-12b-qat-uncensored-hauhaucs-balanced
OLLAMA_MODEL=llama3.2

# ── Claude (your Claude Code login, via claude-local-api) ──
# B:\youtubeProjects\Buzzcaf_Media\claudeAPI runs an OpenAI-compatible server on
# your Claude subscription (Sonnet by default, escalating to Opus; ChatGPT via
# Codex as its own fallback). With a key set it appears as the "Claude" provider
# in the model picker, joins the auto chain after the local servers, and does
# tool calling like the local models. Make a key with:  npm run keys -- create dexter
CLAUDE_API_URL=http://127.0.0.1:8787/v1
CLAUDE_API_KEY=
# Blank = the server's default. Or pin one: sonnet | opus | haiku | claude:default | codex:default
CLAUDE_API_MODEL=

# ── Optional cloud fallbacks (only used if a key is present) ──
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Ports (GUARDIAN_PLAN.md section 11) ──
# No port is hardcoded anywhere. DEXTER_PORT is the port Dexter *prefers*: if
# something already holds it, Dexter takes the next free one (up to +20) rather
# than killing whatever is there, and writes where it landed into the shared
# ledger so the Studio, BuzzBrain, test_dexter_suite.py and the window all find
# it. Leave this unset unless you actually want a different number.
# DEXTER_PORT=8098
#
# The shared ledger. Default %LOCALAPPDATA%\Buzzcaf\ports.json; every app in
# B:\youtubeProjects\Buzzcaf_Media reads and writes the same file. Point it
# somewhere else for a second checkout, or for tests that must not touch the
# real one.
# BUZZCAF_PORTS_FILE=
#
# `npm run dev` only. The built UI is served by the backend and takes its API
# base from window.location.origin, so it needs nothing here; the Vite dev
# server does, because it has to know where to proxy /api and /health. Set it to
# the port Dexter reported (its console prints "READY port=N", and the ledger
# has it too). VITE_DEXTER_UI_PORT moves Vite itself off 3006.
# VITE_DEXTER_PORT=8098
# VITE_DEXTER_UI_PORT=3006

# ── Voice (v10) ──
# Master switch. 0 hides the mic, warms no speech models, and voices nothing.
# DEXTER_VOICE=1
#
# Speech-OUT engine. Primary is Edge-TTS (Microsoft neural voices, ~0 local
# VRAM, far more human than the local model) with emotion carried by per-sentence
# rate/pitch/volume; Kokoro (local, CPU, ~0 VRAM) is the offline fallback.
#   auto   - Edge when the network is up, Kokoro otherwise (default)
#   edge   - Edge only
#   kokoro - local only, never touches the network
# DEXTER_TTS_ENGINE=auto
# DEXTER_EDGE_VOICE=en-US-AndrewMultilingualNeural
#
# Speech-to-text (faster-whisper). tiny|base|small|medium; "small" is the
# default because "base" mishears commands. Device auto tries CUDA and falls
# back to CPU int8 when the cuBLAS/cuDNN DLLs are not installed.
# DEXTER_WHISPER_MODEL=small
# DEXTER_WHISPER_DEVICE=auto
# DEXTER_WHISPER_LANG=en
#
# How Dexter is woken.
#   name  - say "Dexter" (default). openWakeWord has no Dexter model, so the
#           recognizer checks the first two seconds of every sentence it hears
#           and only ones that start with the name go further. No training;
#           costs a short Whisper pass per sentence spoken in the room.
#   model - openWakeWord's phrase model below: instant, no STT until it fires,
#           but the phrase is "hey jarvis" (stock; or a custom-trained .onnx).
#   both  - either one.
# DEXTER_WAKE_MODE=name
# DEXTER_WAKE_NAME=dexter
# DEXTER_NAME_GATE_SECONDS=2.0
# The model for that check (runs on every sentence): base is as reliable as
# small at a third of the cost. Same size as DEXTER_WHISPER_MODEL = one load.
# DEXTER_NAME_GATE_MODEL=base
# DEXTER_WAKEWORD_MODEL=hey_jarvis
# DEXTER_WAKEWORD_THRESHOLD=0.5
#
# Follow-up window: seconds after Dexter replies during which you can answer
# without the wake word. Echo guard: ms the mic stays deaf after Dexter stops.
# Barge-in (talking over Dexter to cut it off) is OFF by default: through
# speakers the mic hears Dexter's own voice. Pressing the mic always interrupts.
# DEXTER_FOLLOWUP_WINDOW=6
# DEXTER_ECHO_GUARD_MS=1200
# DEXTER_VOICE_BARGE_IN=0
#
# What it takes for a sentence nobody addressed to Dexter (inside the follow-up
# window, or in open-mic mode) to count as a command (v13). This is the fix for
# "it's listening to random stuff": the window used to accept any speech at all.
# Short answers - "yes", "no", "go ahead" - are always allowed, and "stop" always
# works. After DEXTER_VOICE_FOLLOWUP_MISSES windows that caught nothing meant for
# Dexter, it stops re-opening them until you say its name.
# DEXTER_VOICE_MIN_WORDS=2
# DEXTER_VOICE_MIN_CONFIDENCE=0.45
# DEXTER_VOICE_FOLLOWUP_MISSES=2
# A borderline speaker verdict in the window needs a fuller sentence than a
# confident one does.
# DEXTER_VOICE_GREY_WORDS=3
# DEXTER_VOICE_GREY_CONFIDENCE=0.5
#
# Kokoro voice: directory holding kokoro-v1.0.onnx and voices-v1.0.bin. Leave
# blank to check ./models then the sibling MidnightBuzz/backend folder.
# KOKORO_DIR=
# Which voice (Settings -> Voice has a Try button): michael fenrir adam puck
# onyx george daniel heart bella nova sarah emma.
# DEXTER_VOICE_KEY=michael
#
# Who is talking (needs `pip install --no-deps resemblyzer`). After "Learn my
# voice" in Settings, only the enrolled voice is answered; Dexter's own voice
# print is refreshed at startup so its echo is never taken as a command.
# DEXTER_SPEAKER_ONLY=1
# Similarity to count as you (measured on a real mic: the owner lands 0.45-0.9,
# so 0.60). Up to DEXTER_SPEAKER_GREY under it still counts when the sentence
# starts with Dexter's name or follows one of yours; every confident match
# teaches the print (DEXTER_SPEAKER_ADAPT, 0 disables).
# DEXTER_SPEAKER_THRESHOLD=0.60
# DEXTER_SPEAKER_GREY=0.15
# DEXTER_SPEAKER_ADAPT=0.08
# DEXTER_ENROLL_SECONDS=10
# Log what the name gate rejected (ambient speech). Off: privacy.
# DEXTER_VOICE_DEBUG=0

# ── Server ──
# Loopback only by default. Every /api/ endpoint also requires the per-run
# session token (written to data/.session_token, served at /api/dexter/auth/token).
DEXTER_HOST=127.0.0.1

# ── Reach Dexter from your phone (Tailscale) ──
# By default Dexter binds to loopback and nothing off the PC can reach it.
# To control it from a phone:
#   1. Install Tailscale on the PC and the phone; run `tailscale up` on both.
#   2. Find the PC's tailnet name/IP: `tailscale ip -4` (a 100.x address) and its
#      MagicDNS name (e.g. my-pc.tailXXXX.ts.net).
#   3. Set the two vars below and restart Dexter.
#   4. On the phone open http://<that-host>:<port> and pair (Settings > Pair a
#      phone on the PC shows a one-time code / QR).
# DEXTER_BIND opens the socket up; DEXTER_TAILNET_HOST is the Host-header
# allowlist (comma-separated: the MagicDNS name and/or the 100.x IP). The token
# bootstrap stays loopback-only, so remote devices must pair for a device token.
# Recommended: also add a Windows Firewall inbound rule limiting the Dexter port
# to the Tailscale adapter, so only tailnet peers can even open the socket.
# DEXTER_BIND=0.0.0.0
# DEXTER_TAILNET_HOST=my-pc.tailXXXX.ts.net,100.x.y.z

# ── Filesystem reach (v13) ──
# How far Dexter may look:
#   machine - the default: every drive and folder you can open yourself, which is
#             what makes "open the C drive", "what's in D:\films" and "list that
#             folder" work at all. Writing, moving and deleting are still refused
#             inside Windows itself (C:\Windows, Program Files, ProgramData, a
#             drive root): a misheard "delete that" there is not recoverable.
#   user    - the pre-v13 behaviour: only the folders in DEXTER_FS_ROOTS.
# Setting DEXTER_FS_ROOTS at all selects 'user' unless this line says otherwise.
# DEXTER_FS_SCOPE=machine
# DEXTER_FS_ROOTS=C:\Users\you\Desktop;B:\projects
# And the other direction: folders Dexter must never touch, reads included.
# DEXTER_FS_DENY=C:\Users\you\Documents\Clients

# ── Knowledge folders (roadmap v5, 4.1) ──
# Folders Dexter indexes into memory so it can answer from your notes,
# documents, YouTube project folders and the Studio's data, citing the file.
# Format: tag=path;tag=path. Tags: notes, docs, youtube, studio (studio only
# takes channel guides, saved topics, agent memories and project files).
# Text, Markdown, CSV, PDF and DOCX are read; code repos, node_modules, etc. skipped.
# DEXTER_KNOWLEDGE_ROOTS=notes=B:\Notes;docs=C:\Users\you\Documents;youtube=B:\youtubeProjects;studio=B:\youtubeProjects\Buzzcaf_Media\BuzzcafAI\backend

# ── Proactive suggestions ──
# Dexter can speak up unprompted: upcoming calendar events, unread email,
# overdue planner items. Conservative by default - banner/toast only, voice
# reserved for events starting within 20 minutes.
# DEXTER_PROACTIVE=1
# DEXTER_QUIET_HOURS=22-8
# DEXTER_SUGGEST_COOLDOWN_MIN=45

# ── The Buzzcaf Studio (optional) ──
# Location of the BuzzcafAI checkout (defaults to the sibling folder), the
# interpreter used to launch its desktop app, and where it listens.
# BUZZCAF_DIR=
# BUZZCAF_PYTHON=
# BUZZCAF_API_URL=http://127.0.0.1:8000

# ── Desktop shell ──
# Close hides the window into the tray (reminders keep firing); Quit is in the tray menu.
# DEXTER_TRAY=1
# DEXTER_HOTKEY=ctrl+alt+d

# ── Browser and coding (v6) ──
# Dexter drives its own Chrome window (profile in data/browser_profile). To attach to a
# Chrome you started with --remote-debugging-port=9222 instead, set:
# DEXTER_BROWSER_CDP=http://127.0.0.1:9222
# Repositories buzzcode may work in (semicolon-separated folders; their child repos are listed).
DEXTER_CODE_ROOTS=B:\youtubeProjects\Buzzcaf_Media
# BUZZCODE_BIN=C:\Users\you\.cargo\bin\buzzcode.exe

# ── Coworker check-ins (v7) ──
# Dexter starts the conversation: morning plan (06:00 or first launch), midday progress, evening close-out.
DEXTER_CHECKINS=1
DEXTER_MIDDAY_HOUR=13

# ── Activity awareness (v7) ──
# Foreground window every 30 s + recently changed files under these roots (plus the knowledge roots).
DEXTER_ACTIVITY=1
DEXTER_ACTIVITY_ROOTS=B:\youtubeProjects

# ── Claude Code's logs (v7) ──
# Dexter reads ~/.claude/projects (read-only) to know what you and Claude did there. It never runs Claude Code.
DEXTER_CLAUDE_LOG=1
# CLAUDE_PROJECTS_DIR=C:\Users\you\.claude\projects

# ── Sentinel, the machine's guardian (v9) ──
# Sentinel (the Rust service on \\.\pipe\Sentinel) decides who gets VRAM and RAM.
# Dexter registers as the `assistant`, asks before every model load, and gives
# memory back when told. With Sentinel absent everything below is ignored and
# Dexter behaves exactly as it did before it existed.
# DEXTER_SENTINEL=1
# SENTINEL_PIPE=\\.\pipe\Sentinel

# What Dexter declares and books for itself.
DEXTER_VRAM_BUDGET_MIB=5120
DEXTER_RAM_BUDGET_MIB=3072
# Context, KV cache and compute buffers are not in the model file's size.
# DEXTER_RESERVE_OVERHEAD_MIB=1024
# How long a booking is held before Sentinel expires it on its own.
# DEXTER_RESERVE_TTL_SECS=90
# Sentinel's priority for an assistant (interactive 80, assistant 60, batch 20).
# DEXTER_PRIORITY=60

# What Dexter books before starting buzzcode's 27B. Refused = the code task is
# refused, with the holder named - never started on top of a render.
DEXTER_ENGINE_VRAM_MIB=12500
DEXTER_ENGINE_RAM_MIB=6500

# Let Dexter run `lms unload --all` when the card goes red. Set to 0 if BuzzEdit
# (or you) owns LM Studio and Dexter must not take its model away.
DEXTER_MANAGE_LMSTUDIO=1

# Whether "clean up space" forwards a RequestCleanup to Sentinel, whose tray runs
# SmartCleaner in your session. `off` disables it. Dexter never deletes anything.
DEXTER_AUTO_CLEAN=safe

# ── The sibling apps (v9) ──
# Where the projects live, and your own overrides for the shipped registry
# (data/apps.default.json). Dexter reads the override file and never writes it.
# DEXTER_APPS_ROOT=B:\youtubeProjects\Buzzcaf_Media
# DEXTER_APPS_FILE=B:\youtubeProjects\Buzzcaf_Media\dexter\data\apps.json
# How long "open <app>" waits for the app's own probe before reporting honestly.
# DEXTER_APP_LAUNCH_WAIT=30
# Drives to report when Sentinel has no disk watch of its own.
# DEXTER_DISK_DRIVES=C:,B:

# ── Mission Reminder bridge (v9) ──
# Read-only: Dexter shows its current block in "Right now" and stays quiet while
# a focus session is running, so you are not nagged by two apps at once.
# MISSION_REMINDER_RUNTIME=C:\Users\you\AppData\Local\MissionReminder\runtime.json

# ── Continuous note-taking (v13) ──
# "Take notes" writes everything you say next into one place until you say stop.
# Where, when you do not name one in the sentence: notes (a Markdown file in the
# notes folder), notepad, sticky, notion, clipboard.
# DEXTER_DICTATION_TARGET=notes

# ── Hand mouse (v13) ──
# The webcam as a pointer: point to move, pinch to click, thumb-to-middle to
# right click, two fingers to scroll, open palm to park. Ctrl+Alt+H stops it.
# Needs opencv-python and onnxruntime, plus the two MediaPipe models that
# "set up hand tracking" downloads into data/models/hand (8 MB, once).
# DEXTER_HAND_CAMERA=0
# DEXTER_HAND_MODELS=
# Steadiness: 0 follows your fingertip exactly, 0.9 is slow and very steady.
# DEXTER_HAND_SMOOTHING=0.6
# A pinch closes below PINCH_ON hand-widths and opens above PINCH_OFF, so a
# trembling hand at the boundary cannot machine-gun clicks.
# DEXTER_HAND_PINCH_ON=0.45
# DEXTER_HAND_PINCH_OFF=0.62
# Wheel notches per hand-width of vertical movement while scrolling.
# DEXTER_HAND_SCROLL_GAIN=9
# Stop by itself after this many minutes (0 = never), and the kill-switch hotkey.
# DEXTER_HAND_MAX_MINUTES=120
# DEXTER_HAND_HOTKEY=ctrl+alt+h
# Detector thresholds, for a dim room or a hand that keeps being missed.
# DEXTER_HAND_PALM_SCORE=0.6
# DEXTER_HAND_TRACK_SCORE=0.5
# DEXTER_HAND_THREADS=2

# ── Mission Reminder: writing as well as reading (v13) ──
# Dexter drives the app's own interface - Ctrl+1..7 for its tabs, its named
# buttons and fields - to save a mission, a goal or a time block, and records
# every attempt in data/mission_outbox.json so a failed save is never a silent
# one. If the app is redesigned, put the new labels in data/mission_ui.json
# rather than editing code.

# ── YouTube (v13) ──
# "Play the second video" clicks the link on the page you are looking at; with
# nothing open it resolves the title through YouTube's own results page and opens
# the video in your Chrome. No API key, nothing logged in.
# DEXTER_YOUTUBE_TIMEOUT=12

# ── Private web search (SearXNG), the BuzzcafAI way ──
# web_search sanitises every query on-device (strips paths, keys, code, directives)
# then tries self-hosted SearXNG first and falls back to DuckDuckGo. Start SearXNG
# with:  cd searxng && docker compose up -d   (see searxng/README.md).
# DEXTER_SEARXNG_URL=http://localhost:8080       # default; also matches BuzzcafAI's instance
# DEXTER_SEARCH_PROVIDER=auto                    # auto (SearXNG->DuckDuckGo) | searxng | duckduckgo

# ── One model at a time (v13.2) ──
# What happens to a model Dexter is no longer using. Until v13.2 a model left
# memory only when its keep-alive expired (30 min for a smart rung, 2 h for the
# pinned fast one), so switching models *added* one instead of replacing it.
#   rungs  - the default: a model that has been replaced is unloaded at once (a
#            superseded ladder rung, a tier you changed in Settings, the tiers
#            while you have picked a model by hand), and the big model goes
#            immediately rather than on its keep-alive when Sentinel says memory
#            is tight. The small fast model stays - every chat turn needs it.
#   always - only the model that just answered stays resident. Saves the most
#            memory; the next switch pays for a reload.
#   off    - v13 behaviour: keep-alive expiry only.
# Nothing another app loaded is ever unloaded, in any mode.
# DEXTER_OFFLOAD_PREVIOUS=rungs
# How long a smart rung stays after an escalated turn, and the fast tier's pin.
# DEXTER_SMART_KEEP_ALIVE=30m
# DEXTER_FAST_KEEP_ALIVE=2h

# ── The hand-mouse preview window (v13.2) ──
# A small always-on-top window showing the skeleton it tracked, the pose it
# decided, and - when it sees nothing - the palm score against the bar it has to
# clear. On by default, because without it "the camera cannot see my hand" and
# "my hand is in a pose that does nothing" look identical. Esc or Q in the window
# stops tracking.
# DEXTER_HAND_PREVIEW=1
# DEXTER_HAND_PREVIEW_WIDTH=360
# How far past its own knuckle a fingertip has to be for a pinch with that finger
# to count. An open hand measures 2.0-2.4, a fist 0.87-0.96 - and in a fist the
# thumb lies against the middle fingertip, which without this was a right click.
# DEXTER_HAND_PINCH_REACH=1.25

# ── Interrupting a reply (v13.8) ──
# "I am not able to interrupt it mid-sentence." The microphone now stays open while
# Dexter speaks, and what it hears then may be one thing only: a control phrase -
# "stop", "be quiet", "never mind". Everything else from that moment is dropped unheard,
# which is what makes it safe where full barge-in is not: Dexter's own voice comes back
# through the speakers and transcribes to the words of its own reply, and those are not
# control phrases, so the echo loop is unreachable rather than unlikely.
# DEXTER_VOICE_INTERRUPT_WORDS=1
# Full barge-in - any sound over the top cuts the reply instantly. Faster, and it cannot
# tell you from Dexter, so it is for headphones.
# DEXTER_VOICE_BARGE_IN=0

# ── Aiming and clicking (v13.8) ──
# The pointer is absolute: a rectangle of the camera image maps onto the whole screen,
# so "speed" is the size of that rectangle. Above 1 it shrinks (less hand movement
# crosses the screen - faster, twitchier); below 1 it grows (slower, much easier to
# aim). 0.5 to 2.5. Also settable from the dashboard panel and out loud.
# DEXTER_HAND_SPEED=1.0
# The pointer holds still from the moment a click pose appears, so the press lands
# where you aimed. Moving further than this - and holding for a moment - is a drag
# instead. 120 px is about 2 cm of hand at arm's length, which sits between the wobble
# of making a pinch (30-90) and a deliberate drag (300+). Scales with the speed above.
# DEXTER_HAND_DRAG_THRESHOLD=120
# Frames a pose must be held before a button goes down, and be gone before it comes up.
# At ~20 fps, 2 is a tenth of a second: far below a deliberate tap, far above the one
# frame of landmark noise that was firing and dropping clicks on its own.
# DEXTER_HAND_CONFIRM_FRAMES=2

# ── Which hand shape does what (v13.6) ──
# One variable per pose, so a gesture is an ordinary setting: it persists, it is in
# the Settings panel under "Hand mouse", it can be changed out loud ("make a fist
# the right click"), and it applies while tracking is running. The values below are
# the defaults, which are exactly what v13.2-v13.5 did.
#
# Actions: point (move the pointer) · pinch (left button, held) ·
#          right-pinch (right button, held) · middle (middle button, held) ·
#          double-click · scroll · park (nothing, and release everything)
# DEXTER_HAND_POSE_OPEN_PALM=point
# DEXTER_HAND_POSE_INDEX=point
# DEXTER_HAND_POSE_TWO_FINGERS=scroll
# DEXTER_HAND_POSE_THREE_FINGERS=point
# DEXTER_HAND_POSE_FIST=park
# DEXTER_HAND_POSE_PINCH_INDEX=pinch
# DEXTER_HAND_POSE_PINCH_MIDDLE=right-pinch
# Any shape none of the above describes (an index and a pinky, say). Bindable
# rather than hidden: a hand makes shapes nobody planned for, and "sometimes it
# does nothing" is the worst thing a gesture mouse can do.
# DEXTER_HAND_POSE_OTHER=point

# ── The watchdog (v13.7) ──
# Dexter froze twice with the log simply ending mid-turn, which rules nothing out. So
# it now keeps its own evidence, outside the logging system: a heartbeat line every
# few seconds into data/heartbeat.txt (turns done, whether one is in flight and for
# how long, when the last HTTP request arrived - which is what distinguishes a frozen
# WebView2 page from a frozen backend, since the microphone lives in the page), and
# every thread's stack into data/stacks.log as soon as a turn overruns.
# DEXTER_WATCHDOG=1
# DEXTER_WATCHDOG_INTERVAL=10
# DEXTER_WATCHDOG_STUCK_AFTER=25
# How long a turn waits for the speech thread before finishing without it. This join
# had no deadline, and it sits between a turn and the "done" the page waits for: if
# synthesis ever sticks, the page never stops thinking, and because the mic is gated
# on that, Dexter goes deaf too.
# DEXTER_TTS_JOIN_TIMEOUT=25

# ── Acting on the page (v13.3) ──
# "search for this in the current tab" goes through the address bar (Ctrl+L), which
# is the only way Chrome lets anything replace the tab you are in. Picking things
# ("the first profile", "the first result", "like", "subscribe", "the comments")
# and moving text between tabs both read Windows' accessibility tree - no page
# scripting, no extension, nothing logged in. Nothing to configure; these are the
# knobs if a page is slow to publish its controls.
# DEXTER_UIA_BUDGET=5

# ── Exact browser control (v13.4): Playwright over CDP ──
# Off until asked for. When a debuggable Chrome is up, Dexter drives the page through
# Playwright instead of Windows accessibility: the nth result is the nth <a href> in
# document order, a field is filled by its label, "copy that" is the real selection
# string, navigation is *waited* for, and Dexter can act without stealing focus.
# Say "turn on precise browser control" and Dexter starts it.
#
# Chrome 136+ refuses --remote-debugging-port on the DEFAULT profile, so the
# debuggable Chrome uses its own profile directory. Sign into Google there once and it
# stays signed in; that window is then the one Dexter can drive exactly. A debug port
# is a local privilege (anything running as you can drive that browser) - it is bound
# to 127.0.0.1 and never started on its own.
# DEXTER_CHROME_CDP=1
# DEXTER_CHROME_DEBUG_PORT=9222
# DEXTER_CHROME_DEBUG_PROFILE=B:\youtubeProjects\Buzzcaf_Media\dexter\data\chrome_debug_profile
# DEXTER_CDP_TIMEOUT=20
# DEXTER_CDP_LAUNCH_WAIT=15
#
# The older, separate Playwright window (v6) is still there as a mode, for anyone who
# wants a browser that is not theirs to lose: DEXTER_BROWSER_MODE=playwright.

# -- Reading the screen, and clicking words on it (v13.8, cache v13.9.1) --
# Chrome does not publish page content to Windows accessibility, so "click on Learn
# more" inside a page is answered by OCR: capture the window, read the pixels, click
# the words. It works anywhere, and it costs 2-3 s a look.
#
# The same screen is not read twice. Every reading is filed under a fingerprint of the
# pixels it read, and each word under a fingerprint of its own pixels. A screen that
# has not moved at all answers from the last reading; and because a real desktop is
# never identical twice (a clock, a caret, an FPS counter - 0.03% of the pixels), a
# click also has the narrower proof available: unchanged pixels *under the word asked
# for* mean that word is still drawn there. Measured live: 9.8 s for the first read of
# both monitors, 2.9 ms to find the same word again. Nothing is ever recalled without
# that proof - if the word's own pixels moved, the screen is read afresh. Turn the
# memory off and every look pays full price again.
# DEXTER_SCREEN_CACHE=1
# DEXTER_SCREEN_CACHE_TTL=120        # re-read a frame this old even if it still matches
# DEXTER_SCREEN_CACHE_MAX=6          # how many distinct frames to keep
# DEXTER_SCREEN_MIN_SCORE=0.55       # below this a match is a guess, and is never clicked
# DEXTER_SCREEN_MIN_CONFIDENCE=0.45  # the OCR engine's own floor; below it is usually an icon
