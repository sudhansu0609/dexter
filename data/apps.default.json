{
  "_comment": [
    "Dexter's registry of the apps under B:\\youtubeProjects\\Buzzcaf_Media (roadmap v9, D3).",
    "One record per app in GUARDIAN_PLAN.md section 0. Shipped defaults; the owner's",
    "overrides go in data/apps.json (same shape, merged by id, nothing here is edited).",
    "vram_mib / ram_mib are what Dexter asks Sentinel for BEFORE launching, so they are",
    "the observed working set, not the best case. exclusive_with names the apps that",
    "cannot share this 16 GB card with it.",
    "preferred_port is a wish, never a fact (GUARDIAN_PLAN.md section 11): an app takes the",
    "next free port when that one is held, and Dexter finds it again through health_path +",
    "ledger_id. Sub-service ports (ComfyUI, XTTS, Vite, Next) live under extra_preferred."
  ],
  "root": "B:\\youtubeProjects\\Buzzcaf_Media",
  "apps": [
    {
      "id": "dexter",
      "label": "Dexter",
      "names": ["dexter", "the assistant", "you"],
      "root": "dexter",
      "launch": {"cmd": "Dexter.vbs", "hidden": true},
      "stop": {"strategy": "none", "why": "Dexter does not stop itself; use the tray's Quit."},
      "probes": [],
      "preferred_port": 8098,
      "health_path": "/health",
      "class": "assistant",
      "vram_mib": 2560,
      "ram_mib": 2048,
      "exclusive_with": [],
      "logs": ["data\\dexter.log"],
      "notes": "The 3B is ~2.5 GB resident, the 7B ~5.5 GB. Model loads go through the steward."
    },
    {
      "id": "buzzcafai",
      "label": "Buzzcaf Studio",
      "names": ["studio", "buzzcaf studio", "buzzcafai", "the studio"],
      "root": "BuzzcafAI",
      "launch": {"cmd": "Buzzcaf Studio.vbs", "hidden": true},
      "stop": {"strategy": "health_route", "route": "{base}/api/studio/shutdown", "method": "POST",
               "fallback": {"strategy": "runtime_pid", "file": "backend\\config\\studio.runtime.json", "key": "pid"}},
      "probes": [
        {"file": "backend\\config\\studio.runtime.json", "max_age_secs": 0}
      ],
      "preferred_port": 8099,
      "health_path": "/health",
      "ledger_id": "buzzcaf",
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 512,
      "exclusive_with": [],
      "logs": ["backend\\logs\\studio.log"],
      "handler": "buzzcaf_client",
      "notes": "Steps forward if 8099 is taken; it keeps studio.runtime.json and also publishes to the shared ledger. Dexter always goes through buzzcaf_client for this one."
    },
    {
      "id": "buzzbrain",
      "label": "BuzzBrain",
      "names": ["buzzbrain", "the chrome extension", "the sensor"],
      "root": "BuzzBrain",
      "launch": {"cmd": null, "why": "A Chrome extension: load it unpacked in Chrome, there is nothing to start."},
      "stop": {"strategy": "none"},
      "probes": [{"http": "{base}/api/buzzbrain/channels", "expect": {}}],
      "preferred_port": 8099,
      "health_path": "/health",
      "ledger_id": "buzzcaf",
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 0,
      "exclusive_with": [],
      "logs": [],
      "notes": "Pushes YouTube watch-page snapshots to the Studio; visible only through it."
    },
    {
      "id": "buzzcode",
      "label": "BuzzCode engine",
      "names": ["buzzcode", "the coder", "the coding engine", "the engine"],
      "root": "BuzzCode",
      "launch": {"cmd": "buzzcode", "args": ["engine", "serve"], "hidden": true, "resolve": "path"},
      "stop": {"strategy": "process_tree", "process": "llama-server.exe", "path_contains": "buzzcode",
               "fallback": {"strategy": "port_owner", "port": 8089}},
      "probes": [{"port": 8089}, {"http": "{base}/health", "expect": {}}],
      "preferred_port": 8089,
      "class": "batch",
      "vram_mib": 12500,
      "ram_mib": 6500,
      "exclusive_with": ["vrdeep", "buzzedit", "buzzworlds"],
      "logs": ["..\\dexter\\data\\code_jobs\\engine.log"],
      "batch_job": true,
      "notes": "Qwen3.8-27B, 12.1 GB of a 16 GB card. Also Dexter's first-choice provider while it is up. Start it through 'buzzcode: ...' or start_local_model so the steward books the memory."
    },
    {
      "id": "buzzedit",
      "label": "BuzzEdit",
      "names": ["buzzedit", "buzz edit", "the editor", "the video editor"],
      "root": "BuzzEdit",
      "launch": {"cmd": "START_APP.vbs", "hidden": true},
      "stop": {"strategy": "process_tree", "process": "electron.exe", "path_contains": "\\BuzzEdit\\"},
      "probes": [
        {"port": 8188},
        {"process": "electron.exe", "path_contains": "\\BuzzEdit\\"}
      ],
      "preferred_port": 8099,
      "health_path": "/api/health",
      "extra_preferred": {"comfyui": 8188},
      "class": "batch",
      "vram_mib": 9216,
      "ram_mib": 8192,
      "exclusive_with": ["vrdeep", "buzzcode", "buzzworlds"],
      "logs": ["logs\\backend.log"],
      "batch_job": true,
      "notes": "Electron + FastAPI (prefers 8099, which is the Studio's number too) + ComfyUI (8188) + LM Studio on 1234. Both step forward and publish now, so the old fixed probe on 8099 - which answered for whichever of the two got there first - is gone. whisper 2-3 GB, ComfyUI 6-12 GB."
    },
    {
      "id": "vrdeep",
      "label": "VrDeep",
      "names": ["vrdeep", "vr deep", "the render queue", "the deepfake pipeline"],
      "root": "VrDeep",
      "launch": {"cmd": "launch_app.vbs", "hidden": true},
      "stop": {"strategy": "process_tree", "process": "python.exe", "path_contains": "\\VrDeep\\",
               "why": "VrDeep pauses itself at lane_pause_free_vram_mb; stopping it mid-render loses the job."},
      "probes": [
        {"process": "python.exe", "path_contains": "\\VrDeep\\"},
        {"process": "pythonw.exe", "path_contains": "\\VrDeep\\"},
        {"file": "output\\session.json", "max_age_secs": 900}
      ],
      "class": "batch",
      "vram_mib": 10240,
      "ram_mib": 15000,
      "exclusive_with": ["buzzcode", "buzzedit", "buzzworlds"],
      "logs": ["output\\session.json"],
      "queue_file": "output\\queue.json",
      "session_file": "output\\session.json",
      "batch_job": true,
      "notes": "9-11 GB VRAM, 14-15 GB commit, plus ffmpeg nvenc. Never evicted by Sentinel: it has its own pause. Confirm before stopping - a render is hours."
    },
    {
      "id": "midnightbuzz",
      "label": "MidnightBuzz",
      "names": ["midnightbuzz", "midnight buzz", "spilled coffee"],
      "root": "MidnightBuzz",
      "launch": {"cmd": "start_app.bat", "hidden": false},
      "stop": {"strategy": "process_tree", "process": "python.exe", "path_contains": "\\MidnightBuzz\\"},
      "probes": [{"port": 8095}, {"port": 8096}, {"process": "python.exe", "path_contains": "\\MidnightBuzz\\"}],
      "preferred_port": 8095,
      "health_path": "/health",
      "extra_preferred": {"xtts": 8096, "vite": 3005},
      "class": "batch",
      "vram_mib": 4096,
      "ram_mib": 5120,
      "exclusive_with": [],
      "logs": [],
      "batch_job": true,
      "warn": "MidnightBuzz binds 0.0.0.0:8095 - it is reachable from your whole network while it runs.",
      "notes": "FastAPI 8095 + XTTS 8096 + Vite 3005. XTTS/RVC stay 2-4 GB resident."
    },
    {
      "id": "mastgaane",
      "label": "MastGaane",
      "names": ["mastgaane", "mast gaane", "the music pipeline"],
      "root": "MastGaane",
      "launch": {"cmd": "uv", "args": ["run", "mastgaane", "serve"], "resolve": "path", "hidden": true},
      "stop": {"strategy": "process_tree", "process": "python.exe", "path_contains": "\\MastGaane\\",
               "fallback": {"strategy": "port_owner", "port": 8787}},
      "probes": [{"port": 8787}, {"process": "python.exe", "path_contains": "\\MastGaane\\"}],
      "preferred_port": 8787,
      "health_path": "/health",
      "class": "batch",
      "vram_mib": 7168,
      "ram_mib": 3072,
      "exclusive_with": ["buzzcode"],
      "logs": [],
      "reports_dir": "reports",
      "batch_job": true,
      "notes": "Runs nightly at 00:30. whisper plus an Ollama 7B (5-10 GB) and its own Chrome profile."
    },
    {
      "id": "caliberai",
      "label": "CaliberAI",
      "names": ["caliberai", "caliber ai", "caliber"],
      "root": "CaliberAI",
      "launch": {"cmd": "CaliberAI.vbs", "hidden": true},
      "stop": {"strategy": "script", "cmd": "Stop CaliberAI.vbs",
               "fallback": {"strategy": "port_owner", "port": 8000}},
      "probes": [{"port": 8000}, {"port": 5173},
                 {"file": "data\\logs\\launcher.log", "max_age_secs": 300}],
      "preferred_port": 8000,
      "health_path": "/api/health",
      "extra_preferred": {"vite": 5173},
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 1024,
      "exclusive_with": [],
      "logs": ["data\\logs\\launcher.log"],
      "notes": "FastAPI 8000 + Vite 5173 (both collide with other apps' defaults). Its own Ollama runner is batch-class from Sentinel's point of view and is evictable."
    },
    {
      "id": "buzzfin",
      "label": "BuzzFin",
      "names": ["buzzfin", "buzz fin", "finance", "the finance app", "the books"],
      "root": "BuzzFin",
      "launch": {"cmd": "BuzzFin.bat", "hidden": false},
      "stop": {"strategy": "port_owner", "port": 8756},
      "probes": [{"port": 8756}],
      "preferred_port": 8756,
      "health_path": "/api/v1/health",
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 512,
      "exclusive_with": [],
      "logs": [],
      "notes": "uv + FastAPI 8756 behind an Edge kiosk window. /health reports {locked, initialized}."
    },
    {
      "id": "buzzcafcoffee",
      "label": "BuzzcafCoffee Ops",
      "names": ["buzzcafcoffee", "coffee", "the coffee ops", "ops"],
      "root": "BuzzcafCoffee",
      "launch": {"cmd": "python", "args": ["ops/run.py", "--assistant"], "cwd": ".", "resolve": "python", "hidden": true},
      "stop": {"strategy": "port_owner", "port": 8010},
      "probes": [{"http": "{base}/api/dashboard", "expect": {}}, {"port": 8010}],
      "preferred_port": 8010,
      "health_path": "/health",
      "extra_preferred": {"next": 3000},
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 320,
      "exclusive_with": [],
      "logs": [],
      "notes": "FastAPI 8010, optional Next on 3000."
    },
    {
      "id": "buzzanimate",
      "label": "BuzzAnimate",
      "names": ["buzzanimate", "buzz animate", "the animator"],
      "root": "BuzzAnimate",
      "launch": {"cmd": "BuzzAnimate.vbs", "hidden": true},
      "stop": {"strategy": "process_tree", "process": "buzz-app.exe"},
      "probes": [{"process": "buzz-app.exe"}],
      "class": "interactive",
      "vram_mib": 2048,
      "ram_mib": 3072,
      "exclusive_with": [],
      "logs": [],
      "warn": "BuzzAnimate runs a cargo build on launch: expect a 1-3 GB RAM spike and a busy CPU for a few minutes.",
      "notes": "Native wgpu app. The launcher builds before it runs, so 'is it running' is false for a while after 'open it'."
    },
    {
      "id": "buzzviolin",
      "label": "BuzzViolin",
      "names": ["buzzviolin", "buzz violin", "the violin app"],
      "root": "BuzzViolin",
      "launch": {"cmd": "BuzzViolin.bat", "hidden": false},
      "stop": {"strategy": "process_tree", "process": "BuzzViolin.exe",
               "fallback": {"strategy": "port_owner", "port": 1420}},
      "probes": [{"port": 1420}, {"process": "BuzzViolin.exe"}],
      "preferred_port": 1420,
      "health_path": "/health.json",
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 512,
      "exclusive_with": [],
      "logs": [],
      "notes": "Tauri dev server on 1420; Vite serves /health.json so a scan can tell it apart. Uses the microphone."
    },
    {
      "id": "buzzworlds",
      "label": "BuzzWorlds",
      "names": ["buzzworlds", "buzz worlds", "the unreal project"],
      "root": "BuzzWorlds",
      "launch": {"cmd": null, "why": "BuzzWorlds is a set of Unreal/Blender scripts - open the editor yourself."},
      "stop": {"strategy": "none"},
      "probes": [{"process": "UnrealEditor.exe"}, {"process": "blender.exe"}],
      "class": "batch",
      "vram_mib": 12288,
      "ram_mib": 12288,
      "exclusive_with": ["vrdeep", "buzzcode", "buzzedit"],
      "logs": [],
      "batch_job": true,
      "notes": "UE 5.7 editor scripts. 8-16 GB either way; nothing else heavy fits beside it."
    },
    {
      "id": "smartcleaner",
      "label": "SmartCleaner",
      "names": ["smartcleaner", "smart cleaner", "the cleaner", "disk cleaner"],
      "root": "SmartCleaner",
      "launch": {"cmd": "run.bat", "hidden": false},
      "stop": {"strategy": "process_tree", "process": "pythonw.exe", "path_contains": "\\SmartCleaner\\"},
      "probes": [{"process": "pythonw.exe", "path_contains": "\\SmartCleaner\\"},
                 {"process": "python.exe", "path_contains": "\\SmartCleaner\\"}],
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 256,
      "exclusive_with": [],
      "logs": [],
      "notes": "The GUI. Disk cleanup itself is Sentinel's job through its tray; say 'clean up space' and Dexter asks Sentinel instead of running this."
    },
    {
      "id": "missionreminder",
      "label": "Mission Reminder",
      "names": ["mission reminder", "missionreminder", "the reminder app", "mission blocks"],
      "root": "missionRemider",
      "launch": {"cmd": "start.cmd", "hidden": false},
      "stop": {"strategy": "process_tree", "process": "electron.exe", "path_contains": "\\missionRemider\\"},
      "probes": [{"process": "electron.exe", "path_contains": "\\missionRemider\\"},
                 {"file_env": "MISSION_REMINDER_RUNTIME", "max_age_secs": 600}],
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 320,
      "exclusive_with": [],
      "logs": [],
      "notes": "Its own mission model (blocks, sessions, tree). Dexter reads its runtime mirror read-only and stays quiet while a session is running."
    },
    {
      "id": "buzzcaf",
      "label": "Buzzcaf (documents)",
      "names": ["buzzcaf", "the buzzcaf documents", "the paperwork"],
      "root": "Buzzcaf",
      "launch": {"cmd": "explorer", "args": ["."], "resolve": "shell", "hidden": false},
      "stop": {"strategy": "none"},
      "probes": [],
      "class": "interactive",
      "vram_mib": 0,
      "ram_mib": 0,
      "exclusive_with": [],
      "logs": [],
      "notes": "Documents only - there is no app. 'Open buzzcaf' opens the folder."
    }
  ]
}
