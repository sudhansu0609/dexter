# Dexter AI Super Assistant - Environment Configuration
# Copy this file to .env and fill in what you need.
# .env is gitignored; this example file is the one that is committed.

# ── Local LLM (the default - Dexter is local-first) ──
# codeBuzz's llama-server (Qwen3.8-27B). Only up while codeBuzz runs; when it
# is, it already holds the GPU, so Dexter uses it first instead of loading a
# second model onto the CPU. Any OpenAI-compatible llama.cpp server works.
LLAMACPP_URL=http://127.0.0.1:8089/v1
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434/v1

# Which local backend Dexter prefers for "auto" requests:
#   auto     - llama-server (8089) if up, then LM Studio, then Ollama (default)
#   llamacpp - force the llama-server first
#   ollama   - run Dexter on Ollama; keeps LM Studio free for other tasks
#              (LM Studio still used as a fallback only if Ollama is down)
#   lmstudio - force LM Studio first
# Point OLLAMA_URL at any Ollama instance (another port/machine) to offload it.
DEXTER_LLM_PROVIDER=auto
# Dexter starts the preferred backend when it is not running (`ollama serve`
# detached, output in data/ollama.log; `lms server start` for LM Studio) - at
# preflight, at startup and whenever a request finds it gone, at most once a
# minute. 0 turns that off.
# DEXTER_AUTOSTART_LLM=1
# DEXTER_AUTOSTART_TIMEOUT=25

# ── Tiered models (instant replies) ──
# A small fast model answers simple conversational turns instantly, and escalates
# to a bigger model for anything needing tools, actions, or current/personal data.
# Both must be pulled on the active provider. Leave DEXTER_FAST_MODEL blank to
# disable the tier and use a single model. When DEXTER_SMART_MODEL is blank the
# escalation uses the provider's default model (OLLAMA_MODEL / auto-detected).
# An explicit model chosen in the UI bypasses tiering and is used as-is.
# DEXTER_FAST_MODEL=qwen2.5:3b
# DEXTER_SMART_MODEL=qwen2.5:7b
# DEXTER_TIERED_LLM=1

# Leave blank to auto-detect whichever model is loaded in LM Studio.
# For reliable tool calling, load a model with strong function-calling support -
# Qwen2.5-7B-Instruct or Qwen3-8B are the best size/quality trade-off locally.
# A 3B model will misfire on multi-step requests.
LM_STUDIO_MODEL=
OLLAMA_MODEL=llama3.2

# ── Optional cloud fallbacks (only used if a key is present) ──
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Ports (GUARDIAN_PLAN.md section 11) ──
# No port is hardcoded anywhere. DEXTER_PORT is the port Dexter *prefers*: if
# something already holds it, Dexter takes the next free one (up to +20) rather
# than killing whatever is there, and writes where it landed into the shared
# ledger so the Studio, BuzzBrain, test_dexter_suite.py and the window all find
# it. Leave this unset unless you actually want a different number.
# DEXTER_PORT=8098
#
# The shared ledger. Default %LOCALAPPDATA%\Buzzcaf\ports.json; every app in
# B:\youtubeProjects\Buzzcaf_Media reads and writes the same file. Point it
# somewhere else for a second checkout, or for tests that must not touch the
# real one.
# BUZZCAF_PORTS_FILE=
#
# `npm run dev` only. The built UI is served by the backend and takes its API
# base from window.location.origin, so it needs nothing here; the Vite dev
# server does, because it has to know where to proxy /api and /health. Set it to
# the port Dexter reported (its console prints "READY port=N", and the ledger
# has it too). VITE_DEXTER_UI_PORT moves Vite itself off 3006.
# VITE_DEXTER_PORT=8098
# VITE_DEXTER_UI_PORT=3006

# ── Voice (v10) ──
# Master switch. 0 hides the mic, warms no speech models, and voices nothing.
# DEXTER_VOICE=1
#
# Speech-to-text (faster-whisper). tiny|base|small|medium; "small" is the
# default because "base" mishears commands. Device auto tries CUDA and falls
# back to CPU int8 when the cuBLAS/cuDNN DLLs are not installed.
# DEXTER_WHISPER_MODEL=small
# DEXTER_WHISPER_DEVICE=auto
# DEXTER_WHISPER_LANG=en
#
# How Dexter is woken.
#   name  - say "Dexter" (default). openWakeWord has no Dexter model, so the
#           recognizer checks the first two seconds of every sentence it hears
#           and only ones that start with the name go further. No training;
#           costs a short Whisper pass per sentence spoken in the room.
#   model - openWakeWord's phrase model below: instant, no STT until it fires,
#           but the phrase is "hey jarvis" (stock; or a custom-trained .onnx).
#   both  - either one.
# DEXTER_WAKE_MODE=name
# DEXTER_WAKE_NAME=dexter
# DEXTER_NAME_GATE_SECONDS=2.0
# The model for that check (runs on every sentence): base is as reliable as
# small at a third of the cost. Same size as DEXTER_WHISPER_MODEL = one load.
# DEXTER_NAME_GATE_MODEL=base
# DEXTER_WAKEWORD_MODEL=hey_jarvis
# DEXTER_WAKEWORD_THRESHOLD=0.5
#
# Follow-up window: seconds after Dexter replies during which you can answer
# without the wake word. Echo guard: ms the mic stays deaf after Dexter stops.
# Barge-in (talking over Dexter to cut it off) is OFF by default: through
# speakers the mic hears Dexter's own voice. Pressing the mic always interrupts.
# DEXTER_FOLLOWUP_WINDOW=9
# DEXTER_ECHO_GUARD_MS=800
# DEXTER_VOICE_BARGE_IN=0
#
# Kokoro voice: directory holding kokoro-v1.0.onnx and voices-v1.0.bin. Leave
# blank to check ./models then the sibling MidnightBuzz/backend folder.
# KOKORO_DIR=
# Which voice (Settings -> Voice has a Try button): michael fenrir adam puck
# onyx george daniel heart bella nova sarah emma.
# DEXTER_VOICE_KEY=michael
#
# Who is talking (needs `pip install --no-deps resemblyzer`). After "Learn my
# voice" in Settings, only the enrolled voice is answered; Dexter's own voice
# print is refreshed at startup so its echo is never taken as a command.
# DEXTER_SPEAKER_ONLY=1
# Similarity to count as you (measured on a real mic: the owner lands 0.45-0.9,
# so 0.60). Up to DEXTER_SPEAKER_GREY under it still counts when the sentence
# starts with Dexter's name or follows one of yours; every confident match
# teaches the print (DEXTER_SPEAKER_ADAPT, 0 disables).
# DEXTER_SPEAKER_THRESHOLD=0.60
# DEXTER_SPEAKER_GREY=0.15
# DEXTER_SPEAKER_ADAPT=0.08
# DEXTER_ENROLL_SECONDS=10
# Log what the name gate rejected (ambient speech). Off: privacy.
# DEXTER_VOICE_DEBUG=0

# ── Server ──
# Loopback only by default. Every /api/ endpoint also requires the per-run
# session token (written to data/.session_token, served at /api/dexter/auth/token).
DEXTER_HOST=127.0.0.1

# ── Filesystem allowlist ──
# Folders Dexter's file tools may touch, separated by ';'. Leave blank for the
# defaults: Desktop, Documents, Downloads, Pictures, Videos, Music, and the
# Dexter project folder.
# DEXTER_FS_ROOTS=C:\Users\you\Desktop;B:\projects

# ── Knowledge folders (roadmap v5, 4.1) ──
# Folders Dexter indexes into memory so it can answer from your notes,
# documents, YouTube project folders and the Studio's data, citing the file.
# Format: tag=path;tag=path. Tags: notes, docs, youtube, studio (studio only
# takes channel guides, saved topics, agent memories and project files).
# Text, Markdown, CSV, PDF and DOCX are read; code repos, node_modules, etc. skipped.
# DEXTER_KNOWLEDGE_ROOTS=notes=B:\Notes;docs=C:\Users\you\Documents;youtube=B:\youtubeProjects;studio=B:\youtubeProjects\Buzzcaf_Media\BuzzcafAI\backend

# ── Proactive suggestions ──
# Dexter can speak up unprompted: upcoming calendar events, unread email,
# overdue planner items. Conservative by default - banner/toast only, voice
# reserved for events starting within 20 minutes.
# DEXTER_PROACTIVE=1
# DEXTER_QUIET_HOURS=22-8
# DEXTER_SUGGEST_COOLDOWN_MIN=45

# ── The Buzzcaf Studio (optional) ──
# Location of the BuzzcafAI checkout (defaults to the sibling folder), the
# interpreter used to launch its desktop app, and where it listens.
# BUZZCAF_DIR=
# BUZZCAF_PYTHON=
# BUZZCAF_API_URL=http://127.0.0.1:8000

# ── Desktop shell ──
# Close hides the window into the tray (reminders keep firing); Quit is in the tray menu.
# DEXTER_TRAY=1
# DEXTER_HOTKEY=ctrl+alt+d

# ── Browser and coding (v6) ──
# Dexter drives its own Chrome window (profile in data/browser_profile). To attach to a
# Chrome you started with --remote-debugging-port=9222 instead, set:
# DEXTER_BROWSER_CDP=http://127.0.0.1:9222
# Repositories buzzcode may work in (semicolon-separated folders; their child repos are listed).
DEXTER_CODE_ROOTS=B:\youtubeProjects\Buzzcaf_Media
# BUZZCODE_BIN=C:\Users\you\.cargo\bin\buzzcode.exe

# ── Coworker check-ins (v7) ──
# Dexter starts the conversation: morning plan (06:00 or first launch), midday progress, evening close-out.
DEXTER_CHECKINS=1
DEXTER_MIDDAY_HOUR=13

# ── Activity awareness (v7) ──
# Foreground window every 30 s + recently changed files under these roots (plus the knowledge roots).
DEXTER_ACTIVITY=1
DEXTER_ACTIVITY_ROOTS=B:\youtubeProjects

# ── Claude Code's logs (v7) ──
# Dexter reads ~/.claude/projects (read-only) to know what you and Claude did there. It never runs Claude Code.
DEXTER_CLAUDE_LOG=1
# CLAUDE_PROJECTS_DIR=C:\Users\you\.claude\projects

# ── Sentinel, the machine's guardian (v9) ──
# Sentinel (the Rust service on \\.\pipe\Sentinel) decides who gets VRAM and RAM.
# Dexter registers as the `assistant`, asks before every model load, and gives
# memory back when told. With Sentinel absent everything below is ignored and
# Dexter behaves exactly as it did before it existed.
# DEXTER_SENTINEL=1
# SENTINEL_PIPE=\\.\pipe\Sentinel

# What Dexter declares and books for itself.
DEXTER_VRAM_BUDGET_MIB=5120
DEXTER_RAM_BUDGET_MIB=3072
# Context, KV cache and compute buffers are not in the model file's size.
# DEXTER_RESERVE_OVERHEAD_MIB=1024
# How long a booking is held before Sentinel expires it on its own.
# DEXTER_RESERVE_TTL_SECS=90
# Sentinel's priority for an assistant (interactive 80, assistant 60, batch 20).
# DEXTER_PRIORITY=60

# What Dexter books before starting buzzcode's 27B. Refused = the code task is
# refused, with the holder named - never started on top of a render.
DEXTER_ENGINE_VRAM_MIB=12500
DEXTER_ENGINE_RAM_MIB=6500

# Let Dexter run `lms unload --all` when the card goes red. Set to 0 if BuzzEdit
# (or you) owns LM Studio and Dexter must not take its model away.
DEXTER_MANAGE_LMSTUDIO=1

# Whether "clean up space" forwards a RequestCleanup to Sentinel, whose tray runs
# SmartCleaner in your session. `off` disables it. Dexter never deletes anything.
DEXTER_AUTO_CLEAN=safe

# ── The sibling apps (v9) ──
# Where the projects live, and your own overrides for the shipped registry
# (data/apps.default.json). Dexter reads the override file and never writes it.
# DEXTER_APPS_ROOT=B:\youtubeProjects\Buzzcaf_Media
# DEXTER_APPS_FILE=B:\youtubeProjects\Buzzcaf_Media\dexter\data\apps.json
# How long "open <app>" waits for the app's own probe before reporting honestly.
# DEXTER_APP_LAUNCH_WAIT=30
# Drives to report when Sentinel has no disk watch of its own.
# DEXTER_DISK_DRIVES=C:,B:

# ── Mission Reminder bridge (v9) ──
# Read-only: Dexter shows its current block in "Right now" and stays quiet while
# a focus session is running, so you are not nagged by two apps at once.
# MISSION_REMINDER_RUNTIME=C:\Users\you\AppData\Local\MissionReminder\runtime.json
