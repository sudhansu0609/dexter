# Dexter AI Super Assistant - Environment Configuration
# Fill in your API keys to enable cloud LLM providers.
# Leave blank to use local models only (LM Studio / Ollama).

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Local LLM Endpoints (defaults shown — only change if custom)
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434/v1
