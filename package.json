{
  "name": "dexter-super-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "concurrently -k \"vite\" \"electron .\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "python backend/preflight.py --quiet && python -m pytest backend -q && tsc --noEmit && vitest run --passWithNoTests"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^4.1.11"
  }
}
